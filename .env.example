OPENAI_API_KEY=sk-your-key-here
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here

# Optional custom OpenAI-compatible endpoint. Ambient OPENAI_BASE_URL is ignored
# so it cannot silently redirect credentials; use only this namespaced setting.
# Plain HTTP is accepted only for localhost loopback development.
# ZEMORY_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: runtime profile.
# "realtime_audio"             — OpenAI Realtime GA audio-in/audio-out. Default.
# "realtime_text_external_tts" — Realtime text output + external TTS.
# "local_cascade"              — Local Silero VAD + OpenAI transcription + Realtime text LLM.
# Legacy aliases "realtime" and "local" are still accepted.
# ZEMORY_PROFILE=realtime_audio

# Optional: voice + behavior tweaks (all have sensible defaults)
# ZEMORY_RESPONSE_LENGTH=one short sentence
# ZEMORY_LOG_JSON=1              # line-delimited JSON logs (for bench scripts)
# ZEMORY_REALTIME__MODEL=gpt-realtime-2.1
# ZEMORY_REALTIME__MAX_OUTPUT_TOKENS=512
# ZEMORY_REALTIME__VOICE=marin

# Optional: local memory/context retrieval.
# ZEMORY_MEMORY_ENABLED=1
# ZEMORY_MEMORY_PATH=.zemory/memory.sqlite3
# ZEMORY_MEMORY_RECALL_DEADLINE_MS=80
# ZEMORY_MEMORY_RECALL_LIMIT=5
# ZEMORY_CONTEXT_TOOL_DEADLINE_MS=200

# Barge-in (interrupt AI mid-speech). Default OFF because laptop mics
# without AEC pick up the speaker and cause false-positive interrupts.
# Enable only with a headset or AEC-capable device.
# ZEMORY_ENABLE_BARGE_IN=1

# Transcript correction — optional context-aware ASR fix-up.
# Adds one billed model call per turn to rewrite the raw transcript using
# recent conversation as context. Realtime profiles run it speculatively, so
# a no-op does not delay response creation; local_cascade waits for the model
# call, and a changed Realtime result cancels/replaces the raw response.
# Default OFF.
# ZEMORY_TRANSCRIPT_CORRECTION_ENABLED=1
# ZEMORY_TRANSCRIPT_CORRECTION_MODEL=gpt-5.6-luna
# ZEMORY_TRANSCRIPT_CORRECTION_HISTORY_TURNS=5
# ZEMORY_TRANSCRIPT_CORRECTION_TIMEOUT_S=5

# "Ready to speak" beep — short tone when the mic goes live (startup +
# after each AI response). It is not captured while playing; the post-gap and
# input-buffer clear reduce, but cannot physically eliminate, residual echo.
# Default ON; tweak/disable via:
# ZEMORY_ENABLE_READY_BEEP=0
# ZEMORY_READY_BEEP_FREQUENCY_HZ=880
# ZEMORY_READY_BEEP_DURATION_MS=80
# ZEMORY_READY_BEEP_VOLUME=0.15
# ZEMORY_READY_BEEP_POST_GAP_S=0.1
